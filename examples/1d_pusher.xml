<mujoco model="1d_pusher">

    <option timestep="0.002"  />
    <option integrator="implicitfast" />
    <!-- <option cone="elliptic" /> -->
    <option gravity="0 0 0" />

    <default>
        <joint damping="1"/>
        <geom friction="0.2 0.005 0.0001" />
    </default>

    <worldbody>

        <!-- Red sphere pusher -->
        <body name="pusher" pos="0 0 0">
            <joint name="pusher_slide"
                   type="slide"
                   axis="1 0 0"/>

            <geom name="pusher_geom"
                  type="sphere"
                  size="0.05"
                  mass="1"
                  rgba="1 0 0 1"/>
        </body>

        <!-- Blue cube object -->
        <body name="object" pos="0.1 0 0">
            <joint name="object_slide"
                   type="slide"
                   axis="1 0 0"/>
            <geom name="object_geom"
                  type="capsule"
                  size="0.05 0.03"
                  mass="1"
                  rgba="0 0 1 1"/>
        </body>

    </worldbody>

    <actuator>
        <position name="pusher_pos"
                  joint="pusher_slide"
                  kp="100"/>
    </actuator>

</mujoco>